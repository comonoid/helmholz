# Style for helmholz C code (same as diam: LLVM base, 2-space, K&R, col 100).
# 2-space indent — keeps deeply-branched code from drifting off-screen.
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 2
TabWidth: 2
UseTab: Never
ColumnLimit: 100
BreakBeforeBraces: Attach        # K&R — opening brace on the same line
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
PointerAlignment: Right
SpaceAfterCStyleCast: false
SortIncludes: false
